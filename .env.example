# LLM provider credentials
# RAG embeddings currently use Azure OpenAI resource 1.
AZURE_API_KEY_1=
AZURE_API_BASE_1=https://your-azure-openai-resource.openai.azure.com/
AZURE_API_VERSION_1=latest

# Optional second Azure OpenAI resource for selected deployments.
AZURE_API_KEY_2=
AZURE_API_BASE_2=
AZURE_API_VERSION_2=latest
AZURE_MODEL_RESOURCE_MAP=

# Optional chat/eval providers.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Enabled chat models shown in the UI. Replace deployment/model names for your environment.
MODELS=azure/your-chat-deployment
CHATBOT_MODEL=azure/your-chat-deployment
INVESTIGATION_MODEL=azure/your-chat-deployment
GUARDRAIL_MODEL=azure/your-chat-deployment
EVALUATION_MODEL=azure/your-chat-deployment
SUMMARIZER_MODEL=azure/your-chat-deployment
GROUNDING_MODEL=azure/your-chat-deployment

# Model output-token limits. Zero omits the provider limit.
CHATBOT_MODEL_MAX_TOKENS=4096
GUARDRAIL_MODEL_MAX_TOKENS=2048
# Azure role processing tier. Set priority only after reviewing cost and availability.
CHATBOT_AZURE_SERVICE_TIER=default
GUARDRAIL_AZURE_SERVICE_TIER=default
SUMMARIZER_MODEL_MAX_TOKENS=1024
TITLE_MODEL=azure/your-chat-deployment
TITLE_MODEL_MAX_TOKENS=32
GROUNDING_MODEL_MAX_TOKENS=4096
GROUNDING_REASONING_EFFORT=medium
GROUNDING_AZURE_SERVICE_TIER=default

# Manual and scheduled screening; one executor per web process, no source-content tracing.
COMPLIANCE_WORKER_ENABLED=true
COMPLIANCE_MODEL=azure/your-chat-deployment
COMPLIANCE_MAX_MESSAGES=10000
COMPLIANCE_MAX_INPUT_CHARACTERS=200000

# Nightly and manual Chat Topics & Sources analysis.
CHAT_INSIGHTS_WORKER_ENABLED=true
CHAT_INSIGHTS_MODEL=azure/your-chat-deployment
CHAT_INSIGHTS_CHAT_BATCH_SIZE=40
CHAT_INSIGHTS_DOCUMENT_BATCH_SIZE=30
CHAT_INSIGHTS_MAX_CONCURRENCY=2
CHAT_INSIGHTS_MAX_INPUT_CHARACTERS=12000

# Buffer provider model responses while preserving live tool lifecycle events.
# Set true only to restore PydanticAI's full provider-delta streaming path.
PROVIDER_MODEL_STREAMING_ENABLED=false
# Per-process, per-upstream-endpoint HTTP connection limits.
PROVIDER_HTTP_MAX_CONNECTIONS=100
PROVIDER_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Isolated stress-test controls; stress providers are forbidden in production.
STRESS_FAKE_LATENCY_SCALE=0
STRESS_FAKE_TOOLS=false
STRESS_FAKE_EMBEDDINGS=false
# Blend each selected stored embedding with a second stored embedding. Range: 0..1.
STRESS_FAKE_EMBEDDING_BLEND=0.05
# Optional loopback services exercise real HTTP(S) pools while retaining fake outputs.
STRESS_HTTP_PROVIDERS_ENABLED=false
STRESS_FAKE_LLM_URL=
STRESS_FAKE_EMBEDDING_URL=
# Required for HTTPS fake-provider URLs; never disable certificate verification.
STRESS_FAKE_PROVIDER_CA_FILE=
# Privacy-safe synthetic payload used for matched HTTP/HTTPS CPU tests (0..1048576 each).
STRESS_FAKE_LLM_REQUEST_PADDING_BYTES=0
STRESS_FAKE_LLM_RESPONSE_PADDING_BYTES=0

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# libpq TLS settings. Local PostgreSQL works with prefer; hosted Neon uses require.
PGSSLMODE=prefer
PGCHANNELBINDING=prefer
# The low-traffic demo uses one async web worker and small per-process pools.
WEB_CONCURRENCY=1
POSTGRES_POOL_SIZE=2
POSTGRES_MAX_OVERFLOW=2
POSTGRES_POOL_TIMEOUT_SECONDS=30
INTERACTIVE_POSTGRES_POOL_SIZE=1
INTERACTIVE_POSTGRES_MAX_OVERFLOW=0
INTERACTIVE_POSTGRES_POOL_TIMEOUT_SECONDS=30
# One privacy-safe OTel aggregate span per DB-active HTTP request; no SQL text or bind values.
DATABASE_OBSERVABILITY_ENABLED=true
OTEL_POSTGRES_POOL_SIZE=1
OTEL_POSTGRES_MAX_OVERFLOW=0
OTEL_POSTGRES_POOL_TIMEOUT_SECONDS=30
# Keep ef_search at or above the largest vector-query candidate LIMIT (currently 150).
HNSW_EF_SEARCH=150
HNSW_ITERATIVE_SCAN=strict_order

# Pytest external DB on the same local Postgres service (second logical DB created by docker compose).
# Must end with _test and differ from POSTGRES_DB.
PYTEST_POSTGRES_SERVER=localhost
PYTEST_POSTGRES_PORT=5432
PYTEST_POSTGRES_USER=postgres
PYTEST_POSTGRES_PASSWORD=
PYTEST_POSTGRES_DB=postgres_test

BACKEND_CORS_ORIGINS=http://localhost:8000,http://localhost:9000,http://localhost:5173,http://localhost:5174

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
BACKEND_HOST=localhost
FRONTEND_HOST=http://localhost:5174
ENVIRONMENT=local

# Frontend dev servers
VITE_API_URL=http://localhost:8000/api

# Required for auth/session signing. Set a long random value before enabling login.
JWT_SECRET_KEY=

# Password registration is disabled by default. Password login remains available.
PASSWORD_REGISTRATION_ENABLED=false
# Registration tokens are used only when password registration is enabled.
USER_REGISTRATION_TOKEN=
ADMIN_REGISTRATION_TOKEN=
DEV_REGISTRATION_TOKEN=

# Optional Microsoft Teams SSO. Keep disabled for normal local development.
TEAMS_SSO_ENABLED=false
TEAMS_SSO_TENANT_ID=
TEAMS_SSO_CLIENT_ID=
TEAMS_SSO_RESOURCE=
TEAMS_SSO_ALLOWED_AUDIENCES=

# Optional browser Microsoft SSO. Configure the Entra application, callback,
# certificate, assignment policy, and exact institutional email domain before enabling.
BROWSER_SSO_ENABLED=false
BROWSER_SSO_TENANT_ID=
BROWSER_SSO_CLIENT_ID=
BROWSER_SSO_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
BROWSER_SSO_ALLOWED_EMAIL_DOMAIN=example.edu
BROWSER_SSO_CERTIFICATE_THUMBPRINT=
# Use the path locally. Production may supply PEM content through an app setting.
BROWSER_SSO_CERTIFICATE_PRIVATE_KEY=
BROWSER_SSO_CERTIFICATE_PRIVATE_KEY_PATH=
BROWSER_SSO_REQUEST_TIMEOUT_SECONDS=10
BROWSER_SSO_FLOW_EXPIRE_MINUTES=10

# Keep enabled normally. Disable only for controlled profiling to isolate the
# cost of persisting filtered OpenTelemetry traces in PostgreSQL.
OTEL_DATABASE_PERSISTENCE_ENABLED=true

# Scheduler toggle. Accepted true values include true/t/yes/y/on/1; accepted false
# values include false/f/no/n/off/0. Scheduled work includes the previous-day
# Screening run at 2:30 AM Eastern and the RAG sync at 3:00 AM Eastern.
# Docker Compose and Azure deployment use a separate app.scheduler_runner process
# while forcing web workers to SCHEDULER=false. Keep false locally unless you
# intentionally want scheduled jobs running.
SCHEDULER=false

# Optional Langfuse OTLP destination.
LANGFUSE_OTEL_ENABLED=false
LANGFUSE_OTEL_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INGESTION_VERSION=4
# local|dev|prod
LANGFUSE_ENVIRONMENT=
